# Copy to .env and fill in. .env is never committed.

# Postgres (Supabase) connection string. Required.
DATABASE_URL=

# Supabase project, for Storage (attachments). Required for the attachment endpoints only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket for report attachments. Optional; default report-attachments.
STORAGE_BUCKET_NAME=report-attachments

# Lifetime of attachment download URLs, in seconds. Optional; default 300 (5 minutes).
STORAGE_URL_EXPIRY_SECONDS=300

# Upload window reported with attachment upload URLs, in seconds. Optional; default 900 (15 minutes).
STORAGE_UPLOAD_URL_EXPIRY_SECONDS=900
